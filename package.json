{
  "name": "antigravity-clearpane-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "install:local": "node scripts/install-local.mjs",
    "build:codex": "node scripts/build-codex.mjs",
    "build:all": "npm run build && npm run build:codex",
    "package:codex": "npm run build:codex",
    "start:codex": "node dist/codex-clearpane/start.mjs",
    "install:codex": "node scripts/install-codex.mjs",
    "test:codex": "npm run build:codex && node --test tests/codex*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.1.3",
    "@mdit/plugin-tasklist": "1.1.3",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
